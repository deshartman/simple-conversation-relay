{
  "name": "simple-conversation-relay-server",
  "version": "4.12.0",
  "description": "WebSocket server for Twilio Conversation Relay",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "start:prod": "NODE_ENV=prod node dist/server.js",
    "dev": "NODE_ENV=dev tsx watch src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
  },
  "keywords": [],
  "author": "Des Hartman",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^17.4.2",
    "events": "^3.3.0",
    "express": "^5.2.1",
    "express-ws": "^5.0.2",
    "fs": "0.0.1-security",
    "openai": "^6.37.0",
    "path": "^0.12.7",
    "twilio": "^6.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@flydotio/dockerfile": "^0.7.10",
    "@types/express": "^5.0.6",
    "@types/express-ws": "^3.0.6",
    "@types/node": "^25.7.0",
    "@vitest/ui": "^4.1.6",
    "nodemon": "^3.1.14",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
