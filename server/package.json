{
  "name": "simple-conversation-relay-server",
  "version": "4.11.0",
  "description": "WebSocket server for Twilio Conversation Relay",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "start:prod": "NODE_ENV=prod node dist/server.js",
    "dev": "NODE_ENV=dev tsx watch src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [],
  "author": "Des Hartman",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "dotenv": "^16.3.1",
    "events": "^3.3.0",
    "express": "^4.21.1",
    "express-ws": "^5.0.2",
    "fs": "0.0.1-security",
    "openai": "^5.12.2",
    "path": "^0.12.7",
    "twilio": "^5.10.6"
  },
  "devDependencies": {
    "@flydotio/dockerfile": "^0.7.10",
    "@types/express": "^5.0.2",
    "@types/express-ws": "^3.0.5",
    "@types/node": "^22.15.19",
    "@vitest/ui": "^4.0.18",
    "nodemon": "^3.0.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.7.1",
    "typescript": "^5.0.0",
    "vitest": "^4.0.18"
  }
}
