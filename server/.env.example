# This is the local NodeJS server .env file. This is NOT used for Twilio Function

# Server Configuration
PORT=3001
SERVER_BASE_URL=your_server_url_here                    # e.g., server-yourdomain.ngrok.dev or your-app.fly.dev

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here                 # OpenAI API key for GPT integration
OPENAI_MODEL=gpt-4o                                     # OpenAI model to use for conversations

# Twilio Configuration (Required for Sync Maps and voice services)
ACCOUNT_SID=your_twilio_account_sid                     # Twilio Account SID
AUTH_TOKEN=your_twilio_auth_token                       # Twilio Auth Token
FROM_NUMBER=your_twilio_phone_number                    # Twilio phone number (e.g., +1234567890)
API_KEY=your_twilio_api_key                             # Twilio API Key for enhanced authentication
API_SECRET=your_twilio_api_secret                       # Twilio API Secret for enhanced authentication

# Twilio Edge Location (Optional - for improved latency in specific regions)
# Specify both edge and region to route API calls through a specific Twilio data center
# Common configurations:
#   Sydney (Australia):  TWILIO_EDGE=sydney    TWILIO_REGION=au1
#   Dublin (Ireland):    TWILIO_EDGE=dublin    TWILIO_REGION=ie1
#   Ashburn (US East):   TWILIO_EDGE=ashburn   TWILIO_REGION=us1
# If not specified, defaults to Twilio's global low-latency routing
TWILIO_EDGE=                                            # e.g., sydney, dublin, ashburn
TWILIO_REGION=                                          # e.g., au1, ie1, us1

# Webhook signature validation (optional)
# Verifies X-Twilio-Signature on the endpoints Twilio calls: /handoff,
# /twilioStatusCallback and /connectConversationRelay. Enabled by default.
# Set to exactly "false" to disable (e.g. if a tunnel rewrites the URL and
# breaks signature matching). Any other value leaves it enabled.
# NOTE: this does NOT protect /outboundCall — Twilio never calls that endpoint,
# so it has no Twilio signature and still needs its own authentication.
TWILIO_VALIDATE_WEBHOOKS=true

# Outbound calling authentication (REQUIRED to use POST /outboundCall)
# Twilio never calls /outboundCall — it is your own API — so signature
# validation cannot protect it. It places calls billed to your account, so it
# requires a bearer token:
#     Authorization: Bearer <OUTBOUND_API_KEY>
# With this unset the route returns 503 rather than running unauthenticated.
# Generate one with:  openssl rand -hex 32
OUTBOUND_API_KEY=

# Rolling-minute cap on outbound calls. Bounds the damage if the token leaks.
# Counted globally (Twilio spend is shared), in-memory per process.
OUTBOUND_RATE_LIMIT_PER_MINUTE=30

# Configuration Management
# Note: Context and manifest configuration is now managed via Sync Maps
# Use the UsedConfig in Sync Maps to configure which context and manifest to use
# See README.md for configuration management details


# --- Low-latency testing additions ---
JEV_API_KEY=                                            # TypeSafe Jev (System One) API key
JEV_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

OPENAI_REASONING_EFFORT=                                # minimal|low|medium|high for gpt-5 family; unset for gpt-4o/4.1

# Initial latency mode: none | jev | embedding | laya (default none). Switchable at runtime via GET/PUT /latency/mode.
LATENCY_MODE=
# Filler matching (see .claude/plans/FILLER-DICTIONARY.md)
LATENCY_EMBED_THRESHOLD=0.59                            # min cosine to send an embedding-matched filler
LATENCY_EMBED_MARGIN=0.01                               # min gap between best and second-best filler score
LATENCY_EMBED_SCORE_BY=mean-top2                        # max | when-only | mean-top2 (tuned on holdout)
LATENCY_JEV_THRESHOLD=0.5                               # min Jev probability of the chosen filler
# LATENCY_JEV_MARGIN=0                                 # min gap between best and second-best Jev score (default 0)
LATENCY_FILLER_BUDGET_MS=400                            # no match by then: speak a neutral fallback ack at once, drop the late match
# LATENCY_HOLD_URL=                                     # hold sound played after the ack until the LLM speaks; unset: https://$SERVER_BASE_URL/media/hold.wav, empty: off
LATENCY_HOLD_LOOP=1                                     # times the hold clip loops
# LATENCY_HANDLER=on                                    # hold sound on/off (off|false|0 = off, else on)
# LATENCY_QUESTION_WAIT_MS=0                            # coherence: wait up to N ms (0-10000) for more words after a statement/filler prompt; 0 = off
# LATENCY_TAKEBACK_WAIT_MS=4000                        # minimum wait after a caller interrupt takes back the pending question (caller is mid-sentence)
# Laya: local laya-serve (scripts/laya/start.sh), same /v1/systemone protocol over plain http.
# LAYA_BASE_URL=http://localhost:8000                   # default; use :8001 for the second checkpoint
# LAYA_API_KEY=                                         # optional; must match LAYA_API_KEY on laya-serve
# LAYA_MODEL=english                                    # english (base) | typed-decisions. Required to pin a checkpoint: unset, laya-serve auto-routes to english
# LATENCY_LAYA_THRESHOLD=0.6                            # min Laya probability of the chosen filler (chosen on dev.json; Laya is over-confident, weak signal)
# LATENCY_LAYA_MARGIN=0                                 # min gap between best and second-best Laya finalist
# LATENCY_LAYA_WARM=on                                  # send one tiny decision at startup / mode switch to absorb the ~13 s MPS kernel compile (off|false|0 = off)
# LATENCY_JEV_WARM=on                                   # open the Jev TLS connection at call start / mode switch (off|false|0 = off)
# LATENCY_COHERENCE_TIMEOUT_MS=600                      # classify timeout; on timeout/error the prompt is sent at once
# LATENCY_TEST_LLM_DELAY_MS=0                            # test only: delay the LLM call by N ms (0-20000) so the hold sound plays
# Handler, question wait and delay can be changed at runtime via /latency/handler, /latency/question-wait and /latency/delay.
