# This is the local NodeJS server .env file. This is NOT used for Twilio Function

# Server Configuration
PORT=3001
SERVER_BASE_URL=your_server_url_here                    # e.g., server-yourdomain.ngrok.dev or your-app.fly.dev

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here                 # OpenAI API key for GPT integration
OPENAI_MODEL=gpt-4o                                     # OpenAI model to use for conversations

# Twilio Configuration (Required for Sync Maps and voice services)
ACCOUNT_SID=your_twilio_account_sid                     # Twilio Account SID
AUTH_TOKEN=your_twilio_auth_token                       # Twilio Auth Token
FROM_NUMBER=your_twilio_phone_number                    # Twilio phone number (e.g., +1234567890)
API_KEY=your_twilio_api_key                             # Twilio API Key for enhanced authentication
API_SECRET=your_twilio_api_secret                       # Twilio API Secret for enhanced authentication

# Twilio Edge Location (Optional - for improved latency in specific regions)
# Specify both edge and region to route API calls through a specific Twilio data center
# Common configurations:
#   Sydney (Australia):  TWILIO_EDGE=sydney    TWILIO_REGION=au1
#   Dublin (Ireland):    TWILIO_EDGE=dublin    TWILIO_REGION=ie1
#   Ashburn (US East):   TWILIO_EDGE=ashburn   TWILIO_REGION=us1
# If not specified, defaults to Twilio's global low-latency routing
TWILIO_EDGE=                                            # e.g., sydney, dublin, ashburn
TWILIO_REGION=                                          # e.g., au1, ie1, us1

# Webhook signature validation (optional)
# Verifies X-Twilio-Signature on the endpoints Twilio calls: /handoff,
# /twilioStatusCallback and /connectConversationRelay. Enabled by default.
# Set to exactly "false" to disable (e.g. if a tunnel rewrites the URL and
# breaks signature matching). Any other value leaves it enabled.
# NOTE: this does NOT protect /outboundCall — Twilio never calls that endpoint,
# so it has no Twilio signature and still needs its own authentication.
TWILIO_VALIDATE_WEBHOOKS=true

# Configuration Management
# Note: Context and manifest configuration is now managed via Sync Maps
# Use the UsedConfig in Sync Maps to configure which context and manifest to use
# See README.md for configuration management details

